# Google OAuth2 credentials (required)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Transport mode: "stdio" (default) or "http"
TRANSPORT=http

# HTTP mode: port to listen on (default: 3000)
PORT=3000

# Path to config.yml for HTTP mode tool filtering (default: ./config.yml)
# CONFIG_PATH=/path/to/config.yml

# Path to store OAuth tokens for stdio mode (default: ~/.google-mcp-tokens.json)
# GOOGLE_TOKENS_PATH=/path/to/tokens.json
